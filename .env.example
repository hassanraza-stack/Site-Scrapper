# --- AWS RDS ---
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@database-1.cxi8mos4gel7.ap-southeast-2.rds.amazonaws.com:5432/postgres?sslmode=require&uselibpqcompat=true

# --- Local Docker ---
DATABASE_URL=postgresql://mcq:mcq_dev_password@localhost:5433/mcq_bank

HEADLESS=true
CRAWL_DELAY_MS=2000
# Per-page scrape retries after crash/network error
MAX_PAGE_RETRIES=5
# Restart Chromium every N pages (small EC2: 10–15)
BROWSER_RESTART_EVERY=15

# --- Embeddings (OpenRouter) ---
OPENROUTER_API_KEY=
EMBED_MODEL=openai/text-embedding-3-small
EMBED_BATCH_SIZE=64
EMBED_MAX_ATTEMPTS=5
EMBED_DELAY_MS=200
# Stay under model 8192-token limit. Urdu can be ~1 token/char — keep ≤7500.
EMBED_MAX_CHARS=7500
# Re-queue failed rows at each start (set 0 to disable)
EMBED_RESET_FAILED=1
# Optional OpenRouter ranking headers
# OPENROUTER_HTTP_REFERER=https://github.com/your-repo
# OPENROUTER_APP_TITLE=MCQ Scraper Embeddings

# pgAdmin (local docker): http://localhost:5051
# Login: admin@example.com / admin
# Host: postgres  Port: 5432  User: mcq  Pass: mcq_dev_password  DB: mcq_bank
